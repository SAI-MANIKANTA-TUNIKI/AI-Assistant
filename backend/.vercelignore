# .vercelignore (project root)

# Python virtual environments — these are often the biggest culprits
.venv/
venv/
env/
.venv-*
**/.venv-*

# Python caches and compiled files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node modules
node_modules/

# Local build/run artifacts
outputs/
build/
dist/
.vercel/
_uv/
session/
*.log